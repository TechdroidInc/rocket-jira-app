{
    "name": "rocket-jira-app",
    "private": true,
    "version": "0.1.0",
    "description": "Rocket.Chat App that rewrites Jira issue keys in messages into markdown links with the issue summary",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "package": "rc-apps package",
        "package-store": "rc-apps package --no-compile",
        "deploy": "rc-apps deploy"
    },
    "devDependencies": {
        "@rocket.chat/apps-cli": "^1.14.0",
        "@rocket.chat/apps-engine": "^1.65.1",
        "@rocket.chat/ui-kit": "^0.36.1",
        "@types/node": "^20.0.0",
        "typescript": "^5.6.2"
    }
}
